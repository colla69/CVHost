# Copy to scripts/.env.deploy (gitignored). Nothing here needs filling in.

# Leave unset: the bucket comes from the CvHostSite stack output. Setting it
# overrides that, and the old pre-CloudFront bucket (cv-host) still exists.
#DEPLOY_BUCKET=

# Optional key prefix inside the bucket, if the site is not at the root
#DEPLOY_PREFIX=

AWS_PROFILE=default
AWS_REGION=eu-central-1

# Needed on machines behind Zscaler TLS interception; the script auto-detects
# this path, so it only needs setting if the bundle lives somewhere else.
#AWS_CA_BUNDLE=$HOME/.aws/corporate-ca.pem
